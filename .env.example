# This contains Trilium connection settings which are used when running
# test cases and examples. Just copy this to a file named ".env" and 
# change the values.

TRILIUM_ALCHEMY_HOST = "http://localhost:8080"
TRILIUM_ALCHEMY_TOKEN = "MY_TOKEN"

# only used if TRILIUM_ALCHEMY_TOKEN not defined, or in test cases exercising login
TRILIUM_ALCHEMY_PASSWORD = "MY_PASSWORD"

# only required for some test cases, not examples
TRILIUM_ALCHEMY_DATA_DIR = "./.trilium_data"

# only required for publishing docs
TRILIUM_ALCHEMY_DOCS_DIR = "../mm21.github.io/trilium-alchemy"
